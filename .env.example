IFM_API_KEY=
GOOGLE_MAPS_BROWSER_KEY=
PORT=3000

# Organizer invitation mail (private; never add credentials to README)
PUBLIC_SITE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Local demo email links only (keep 0 for a public deployment)
MAIL_DEMO_MODE=0

# SMS via Twilio; keep credentials in .env only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
